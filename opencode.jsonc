{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "docs/examples/**", "effect": "deny" },
    { "action": "edit", "resource": "binaries/**", "effect": "deny" },
    { "action": "edit", "resource": "models/**", "effect": "deny" },
    { "action": "edit", "resource": ".git/**", "effect": "deny" },
    { "action": "edit", "resource": ".worktrees/**", "effect": "deny" },
    { "action": "shell", "resource": "git push -u origin task/*", "effect": "allow" },
    { "action": "shell", "resource": "git push origin task/*", "effect": "allow" },
    { "action": "shell", "resource": "git push origin main*", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push --tags*", "effect": "deny" },
    { "action": "shell", "resource": "git tag *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git remote *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr *", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ]
}
